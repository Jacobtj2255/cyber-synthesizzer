# Copy to .env and edit:   cp .env.example .env
# Values here override the defaults in config.py (environment variables override both).

# --- Database: comment out to use SQLite (zero setup)
# NDACS_DB_URL=mysql+pymysql://ndacs:ndacs123@localhost/ndacs

# --- Dashboard login (CHANGE THESE)
NDACS_DASHBOARD_USER=admin
NDACS_DASHBOARD_PASSWORD=ndacs@123
NDACS_SECRET_KEY=replace-with-any-long-random-string

# --- Capture interface (find yours with: ip a)
# NDACS_INTERFACE=enp0s8

# --- Automated response: dry-run | block | redirect
NDACS_RESPONSE_MODE=dry-run
NDACS_BLOCK_DURATION_MIN=30
# IPs that must never be blocked (gateway, your host PC, ...), comma separated
NDACS_WHITELIST=127.0.0.1,10.0.2.2,10.0.2.3

# --- Detection thresholds
NDACS_ALERT_THRESHOLD=0.70
NDACS_BLOCK_THRESHOLD=0.90
# shap | lime | occlusion
NDACS_EXPLAINER=shap

# --- Optional Cowrie SSH honeypot log (see deploy/cowrie-docker-compose.yml)
# NDACS_COWRIE_JSON_LOG=/home/<you>/NDACS/deploy/cowrie-logs/cowrie.json
